[Unit]
Description=Portmap VPS Server and Console (8.130)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zxhtom
Group=zxhtom
ExecStart=/home/zxhtom/.local/bin/portmap server serve --relay-data-dir /home/zxhtom/.config/portmap-relay --listen 127.0.0.1:9881 --web-listen 127.0.0.1:9890 --zone port.toms.chat
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
