[Unit]
Description=Portmap - Port Mapping Manager
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/portmap serve --log-file=/var/log/portmap/portmap.log
Restart=always
RestartSec=5
User=nobody
Group=nogroup
Environment=PORTMAP_HOME=/etc/portmap

[Install]
WantedBy=multi-user.target
